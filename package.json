{
  "name": "enterprise-rms",
  "version": "1.0.0",
  "description": "Enterprise Multi-Unit Restaurant Management System (RMS) - Distributed Event-Driven Edge Architecture",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev:hq": "tsx watch src/hq-cloud/server.ts",
    "dev:edge": "tsx watch src/store-edge/server.ts",
    "dev:ui": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:sync-spike": "vitest run tests/sync-spike.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.17.0",
    "better-sqlite3": "^9.6.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
