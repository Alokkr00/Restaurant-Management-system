{
  "name": "enterprise-rms",
  "version": "1.0.0",
  "description": "Enterprise Multi-Unit Restaurant Management System (RMS) - Distributed Event-Driven Edge Architecture",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev:hq": "tsx watch src/hq-cloud/server.ts",
    "dev:edge": "tsx watch src/store-edge/server.ts",
    "dev:ui": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:load": "tsx tests/load/concurrent-orders.ts",
    "test:chaos": "tsx tests/load/offline-chaos.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^9.0.1",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
